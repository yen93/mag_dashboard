# ── Dependencies / build output ─────────────────────────────
node_modules/
client/node_modules/
client/dist/
dist/
build/

# ── Environment & secrets — NEVER commit these ──────────────
.env
.env.*
!.env.example
*.env
env.json

# Credential / secret file-name patterns
*connection_string*
*secret*
*_secret*
*credential*
*credentials*
*password*
*apikey*
*api_key*
*api-key*
*.token
*_token
*-token.*

# ── Keys & certificates ─────────────────────────────────────
*.pem
*.key
*.keyfile
*.p12
*.pfx
*.pkcs12
*.asc
*.gpg
id_rsa*
id_ed25519*

# ── Cloud / service-account credentials ─────────────────────
service-account*.json
*service-account*.json
*-service-account*.json
client_secret*.json
gcp-*.json
google-credentials*.json
gha-creds-*.json
*.gcloud-key.json

# ── Supabase local state (project refs, local env) ──────────
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
# Per-edge-function local env files (any function subfolder)
supabase/functions/**/.env
supabase/functions/**/.env.*

# ── Sensitive files inside ANY subfolder (explicit recursive coverage) ──
# (most patterns above already recurse, since git applies slash-less patterns at
#  every depth; these make subfolder coverage explicit and close hyphen/underscore
#  and extension gaps.)
**/.env
**/.env.*
!**/.env.example
**/*.env
**/*secret*
**/*credential*
**/*credentials*
**/*password*
**/*passwd*
**/*connection_string*
**/*apikey*
**/*api_key*
**/*api-key*
**/*.token
**/*_token
**/*-token.*
# Keys & certificates
**/*.pem
**/*.key
**/*.keyfile
**/*.p12
**/*.pfx
**/*.pkcs12
**/*.crt
**/*.cer
**/*.cert
**/*.asc
**/*.gpg
**/id_rsa*
**/id_ed25519*
# Service-account / OAuth credential JSONs (both hyphen AND underscore variants)
**/service-account*.json
**/*service-account*.json
**/service_account*.json
**/*service_account*.json
**/client_secret*.json
**/google-credentials*.json
**/google_credentials*.json
**/gcp-*.json
**/credentials.json
# Package/registry auth files that carry tokens
**/.npmrc
**/.netrc
**/.pgpass

# ── Raw financial exports (source docs; the aggregates the app uses are already ──
#    seeded into Supabase via migrations, so these full account-level P&L files
#    don't belong in the repo). Un-ignore deliberately if you want them tracked.
FY22 - FY23 PNL/
**/*Profit_and_Loss*.xlsx

# ── Scratch / throwaway files ───────────────────────────────
scratch_*
scratch/
tmp/
*.tmp

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS & editor cruft ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
