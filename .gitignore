# ── Dependencies / build output ─────────────────────────────
node_modules/
client/node_modules/
client/dist/
dist/
build/

# ── Environment & secrets — NEVER commit these ──────────────
.env
.env.*
!.env.example
*.env
env.json

# Credential / secret file-name patterns
*connection_string*
*secret*
*_secret*
*credential*
*credentials*
*password*
*apikey*
*api_key*
*api-key*
*.token
*_token
*-token.*

# ── Keys & certificates ─────────────────────────────────────
*.pem
*.key
*.keyfile
*.p12
*.pfx
*.pkcs12
*.asc
*.gpg
id_rsa*
id_ed25519*

# ── Cloud / service-account credentials ─────────────────────
service-account*.json
*service-account*.json
*-service-account*.json
client_secret*.json
gcp-*.json
google-credentials*.json
gha-creds-*.json
*.gcloud-key.json

# ── Supabase local state (project refs, local env) ──────────
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*

# ── Scratch / throwaway files ───────────────────────────────
scratch_*
scratch/
tmp/
*.tmp

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS & editor cruft ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
